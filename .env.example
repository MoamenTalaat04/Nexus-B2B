# Copy to .env (repo root) and fill in what you need. The defaults work for local development with mocks.

# --- Infrastructure (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# --- Security
JWT_SECRET=change-me
# Fernet key for encrypting channel tokens. Generate one from backend/ with:
#   uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Public URLs
# HTTPS tunnel to your backend (cloudflared or ngrok) so WhatsApp webhooks reach your laptop
PUBLIC_BASE_URL=https://<your-tunnel>.trycloudflare.com
FRONTEND_ORIGIN=http://localhost:3000

# --- Mocks (true = fake Google, WhatsApp and LLM; no keys needed)
USE_MOCK_ADAPTERS=true
USE_MOCK_LLM=true

# --- LLM (provider-neutral; any OpenAI-compatible API)
# Development uses a free tier. Fill these from docs/setup-accounts.md. With USE_MOCK_LLM=true they can stay empty.
# Examples of OpenAI-compatible base URLs (check the provider's docs for the current value and model names):
#   Google Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:           https://api.groq.com/openai/v1
#   OpenRouter:     https://openrouter.ai/api/v1
#   Local Ollama:   http://localhost:11434/v1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
# Model for reasoning and writing
LLM_MODEL_SMART=
# Cheaper/faster model for bulk scoring and classification
LLM_MODEL_FAST=
# Max parallel LLM calls (free tiers are rate-limited)
LLM_MAX_CONCURRENCY=2

# --- Google Places API (New)
GOOGLE_PLACES_API_KEY=

# --- WhatsApp Cloud API
# Meta app secret (webhook signature check)
WHATSAPP_APP_SECRET=
# Any random string; the same value goes in the Meta dashboard
WHATSAPP_VERIFY_TOKEN=
# Current Graph API version from the Meta docs, e.g. v2x.0
WHATSAPP_GRAPH_VERSION=

# --- Telegram (owner notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Files
UPLOAD_DIR=./data/uploads

# --- Misc
TIMEZONE=Africa/Cairo
LOG_LEVEL=INFO
