# Copy to .env (repo root) and fill in what you need. The defaults work for local development with mocks.

# --- Infrastructure (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# --- Security
JWT_SECRET=change-me
# Fernet key for encrypting channel tokens. Generate one from backend/ with:
#   uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Public URLs
# HTTPS tunnel to your backend (cloudflared or ngrok) so WhatsApp webhooks reach your laptop
PUBLIC_BASE_URL=https://<your-tunnel>.trycloudflare.com
FRONTEND_ORIGIN=http://localhost:3000

# --- Mocks (true = fake Google, WhatsApp and LLM; no keys needed)
# Set USE_MOCK_API=true only in local development to serve the in-memory mock API instead of DB-backed routes
USE_MOCK_API=false
USE_MOCK_ADAPTERS=true
USE_MOCK_LLM=true

# --- LLM (provider-neutral; any OpenAI-compatible API)
# Development uses a free tier. Fill these from docs/setup-accounts.md. With USE_MOCK_LLM=true they can stay empty.
# Examples of OpenAI-compatible base URLs (check the provider's docs for the current value and model names):
#   Google Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:           https://api.groq.com/openai/v1
#   OpenRouter:     https://openrouter.ai/api/v1
#   Local Ollama:   http://localhost:11434/v1
# Team default: Google Gemini (free tier in Google AI Studio; only fictional/demo data on the free tier).
# Backup: Groq -> LLM_BASE_URL=https://api.groq.com/openai/v1, models openai/gpt-oss-120b (smart) and
# openai/gpt-oss-20b (fast), LLM_REASONING_MODELS empty. Only one provider is active at a time.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Your own key from https://aistudio.google.com (never commit it)
LLM_API_KEY=
# Model for reasoning and writing
LLM_MODEL_SMART=gemini-4-hydrogen
# Cheaper/faster model for bulk scoring and classification
LLM_MODEL_FAST=gemini-3.5-flash-lite
# Max parallel LLM calls (free tiers are rate-limited)
LLM_MAX_CONCURRENCY=2
# Comma-separated model ids that accept `reasoning_effort` (check the provider's docs); others never get it
LLM_REASONING_MODELS=gemini-4-hydrogen
# Timeout for one LLM HTTP request, in seconds
LLM_TIMEOUT_SECONDS=120

# --- Auth0 (Hybrid Auth0 + PostgreSQL; leave blank for local Argon2/JWT auth) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_CONNECTION=Username-Password-Authentication

# --- Google Places API (New) ---
# Free option for development/demo: a Google Maps Platform "Maps Demo Key" (no billing; usage pauses at
# its daily limit, never charges). A billed key also works (Text Search with phone fields = Enterprise tier).
GOOGLE_PLACES_API_KEY=

# --- WhatsApp Cloud API
# Meta app secret (webhook signature check)
WHATSAPP_APP_SECRET=
# Any random string; the same value goes in the Meta dashboard
WHATSAPP_VERIFY_TOKEN=
# Current Graph API version from the Meta docs, e.g. v2x.0
WHATSAPP_GRAPH_VERSION=

# --- Telegram (owner notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Files
UPLOAD_DIR=./data/uploads

# --- Demo seed (optional; used only by `uv run poe seed-demo`)
# Comma-separated WhatsApp test phones for the demo tenant's whitelist (max 5)
DEMO_WHITELIST=

# --- Misc
TIMEZONE=Africa/Cairo
LOG_LEVEL=INFO
